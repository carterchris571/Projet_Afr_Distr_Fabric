model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	dataSourceDefaultMaxConnections: 50
	sourceQueryCulture: fr-FR
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Date_table","DirectQuery à AS – Modele_KPI_sales"]

ref table Date_table
ref table Segmentation
ref table Cluster
ref table Net_adds_cluster
ref table Out_stock_cluster
ref table DTR_DTC_cluster
ref table Mesure
ref table Listing_hierachique3

ref cultureInfo en-US

