            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!param_date_fin.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
    'Listing_hierachique3'[Date],
    'Listing_hierachique3'[Status],
    'Listing_hierachique3'[Type],
    'Listing_hierachique3'[From_num],
    'Listing_hierachique3'[From_name],
    'Listing_hierachique3'[To_num],
    'Listing_hierachique3'[To_name],
    'Listing_hierachique3'[Amount],
    
    FILTER(
        VALUES('Cluster'[Centre_]),
        'Cluster'[Centre_] = @param_zone
    ),
    FILTER(
        VALUES('Cluster'[SA_incharge]),
        'Cluster'[SA_incharge] = @param_sa_incharge
    ),
    FILTER(
        VALUES('Cluster'[Cluster]),
        'Cluster'[Cluster] = @param_cluster
    ),
    FILTER(
        VALUES('Listing_hierachique3'[Type]),
        'Listing_hierachique3'[Type] = @param_type
    ),
    FILTER(
        'Listing_hierachique3',
        'Listing_hierachique3'[Date] &gt;= @param_date_debut &amp;&amp;
        'Listing_hierachique3'[Date] &lt;= @param_date_fin
    )
)</CommandText>
