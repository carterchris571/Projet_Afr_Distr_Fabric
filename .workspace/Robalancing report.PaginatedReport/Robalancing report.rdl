  <DataSets>
    <DataSet Name="DataSet_listing">
      <Query>
        <DataSourceName>DataSource_listing_seg</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@param_type">
            <Value>=Parameters!param_type.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Date_debut">
            <Value>=Parameters!Date_debut.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Date_fin">
            <Value>=Parameters!Date_fin.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@param_numero">
            <Value>=Parameters!param_numero.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select * from Listing_hierachique3

where Type in (@param_type)
and [Date] between @Date_debut and @Date_fin
AND (
      @param_numero IS NULL
      OR @param_numero = ' '
      OR From_num = @param_numero
      OR To_num = @param_numero
    )
order by [Date]</CommandText>
      </Query>
