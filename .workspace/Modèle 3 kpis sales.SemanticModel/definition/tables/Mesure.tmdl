	measure 'Nom Agent SIM' =
			
			VAR NumPOS = SELECTEDVALUE(Segmentation[Num_POS])
			RETURN
			LOOKUPVALUE(
			    Listing_hierachique3[From_name],
			    Listing_hierachique3[From_num], NumPOS
			)
		lineageTag: 82b892af-782e-422f-aefe-ce5d17c1bb77

	measure '#day selectionne' =
			
			SELECTEDVALUE(Slicers_Days[NbJours], 1)
		formatString: 0
		lineageTag: 30403fc4-ab2c-4ee7-be66-9777763d5190

	measure Start_day_selectionne =
			
			TODAY() - [#day selectionne]
		formatString: General Date
		lineageTag: 51c1ad9f-faf3-4f53-a263-7f072139ed99

	measure #Transac_periode =
			
			VAR SelectedPOS =
			SELECTEDVALUE ( Segmentation[Num_POS] )
			RETURN
			CALCULATE(
			    COUNTROWS(Listing_hierachique3),
			    Listing_hierachique3[From_num] = SelectedPOS,
			    Date_table[Date] > [Start_day_selectionne],
			    Date_table[Date] <= TODAY()
			)
		lineageTag: a4f61e27-5410-4731-bb6c-b1c02c5c5573

	measure Montant_periode = ```
			
			VAR SelectedPOS =
			    SELECTEDVALUE(Segmentation[Num_POS])
			RETURN    
			CALCULATE(
			    SUMX(Listing_hierachique3,
			    ABS(Listing_hierachique3[Amount])),
			    Listing_hierachique3[From_num] = SelectedPOS,
			    Date_table[Date] > [Start_day_selectionne],
			    Date_table[Date] <= TODAY()
			)
			```
		lineageTag: 4a3bc0a1-e1e0-4d88-a098-81ee200d0e19

