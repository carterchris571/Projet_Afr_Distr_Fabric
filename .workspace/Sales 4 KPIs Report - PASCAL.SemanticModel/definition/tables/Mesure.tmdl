		displayFolder: TMAS sys
		lineageTag: c3c2102d-2095-46b4-b9c6-4ee365e7ce2c
		sourceLineageTag: 4a3bc0a1-e1e0-4d88-a098-81ee200d0e19
		dataCategory: Uncategorized

		changedProperty = DisplayFolder

	measure '#Transac_periode 2' =
			
			VAR SelectedPOS = SELECTEDVALUE(Segmentation[Num_POS])
			VAR StartDate = [Start_day_selectionne]
			RETURN
			CALCULATE(
			    COUNTROWS(Listing_hierachique3),
			    Listing_hierachique3[From_num] = SelectedPOS,
			    Listing_hierachique3[Date] > StartDate,
			    Listing_hierachique3[Date] <= TODAY()
			)
		formatString: 0
		displayFolder: TMAS sys
		lineageTag: 0757468c-746a-4bf8-874b-8d37274ad870

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Montant_periode 2' =
			
			CALCULATE(
			    SUMX(
			        Listing_hierachique3,
			        ABS(Listing_hierachique3[Amount])
			    )
			)
		formatString: #,0
		displayFolder: TMAS sys
		lineageTag: 4ccf03ce-f62e-4747-8c01-68a5664f5ad8

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure #Trat3 =
			
			CALCULATE(
			    COUNTROWS(Listing_hierachique3)
			)
		formatString: 0
		displayFolder: TMAS sys
		lineageTag: da27d967-21cc-4c15-b75a-5004717835ba

		changedProperty = Name

		changedProperty = DisplayFolder

	measure MTD_Target =
			
			SUMX(
			    FILTER(Sodi_feuil, Sodi_feuil[Type] = "Target"),
			    Sodi_feuil[Day_Target] * (DAY(TODAY()) - 1)
			)
		formatString: #,0
		lineageTag: f69be1da-ebec-4286-8fa0-7056e1194222

		changedProperty = Name

		changedProperty = FormatString

	measure GAP_MTD = ```
			
			    CALCULATE(
			        SUM(Sodi_feuil[Montant]),
			        Sodi_feuil[Type] = "Real"
			    )
			-
			[MTD_Target]
			
			```
		formatString: #,0
		lineageTag: eb74da00-c2e3-495e-8ee0-ee03b9fb7192

		changedProperty = Name

		changedProperty = FormatString

	measure Perf = ```
			DIVIDE( 
			                CALCULATE(
			                    SUM(Sodi_feuil[Montant]),
			                    Sodi_feuil[Type] = "Real"
			                ),
			                [MTD_Target],
			                0
			    )   
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 5a9c3f94-c5f0-4e81-bada-193ae07881aa

		changedProperty = Name

		changedProperty = FormatString

	partition Mesure = entity
		mode: directQuery
		source
			entityName: Mesure
			expressionSource: 'DirectQuery à AS – Modèle 3 kpis sales'

